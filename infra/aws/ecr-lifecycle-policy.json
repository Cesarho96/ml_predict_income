{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Imagenes sin tag (pushes incompletos o reemplazados): borrar despues de 1 dia",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 1
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 10,
      "description": "Conservar las 30 imagenes mas recientes: ventana de rollback de ~30 merges a main",
      "selection": {
        "tagStatus": "any",
        "countType": "imageCountMoreThan",
        "countNumber": 30
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}
