# Todo lo que no debe entrar al contexto de build.
# Sin esto, Docker sube ~700 MB de microdatos y notebooks al daemon en cada build,
# y cualquier cambio en un notebook invalida la caché de capas.

.git
.gitignore
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.ipynb_checkpoints

notebooks/
reports/
data/
*.ipynb

# Hito 3: ningún modelo entra a la imagen; se descargan del registry al arrancar.
models/
mlruns/
mlartifacts/
mlflow.db
tests/
scripts/
docker/
docker-compose.yml

.env
*.log
Dockerfile
.dockerignore
README.md
